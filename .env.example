APP_NAME="WebGuard Investigasi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://webguard.yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Database Configuration (MySQL / MariaDB on aaPanel or Docker)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webguard_db
DB_USERNAME=webguard_user
DB_PASSWORD=your_strong_database_password

# Session & Storage
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
FILESYSTEM_DISK=local

# Cache & Queues (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password_if_set
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@webguard.yourdomain.com"
MAIL_FROM_NAME="WebGuard Investigasi Siber"

# WhatsApp Official Gateway Integration
WHATSAPP_GATEWAY_URL="https://api.fonnte.com/send"
WHATSAPP_API_KEY=""

# External Intelligence Providers (Optional API Keys for Passive Analysis)
VIRUSTOTAL_API_KEY=""
IPINFO_TOKEN=""
SHODAN_API_KEY=""
WHOISXML_API_KEY=""

# Rate Limiter Settings
RATE_LIMIT_LOGIN=10
RATE_LIMIT_ANALYSIS=15

# Google OAuth Single Sign-On (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api/v1"
